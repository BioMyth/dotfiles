# Setup software to run

## SSH

# Load up ssh agent
if [ "$SESSION_TYPE" = 'remote/ssh' ]; then
    # Do Nothing
    :
elif exists keychain; then
    eval $(keychain --eval --quiet --noask)
else
    
    ssh_agent_file="${XDG_RUNTIME_DIR:-$HOME/.cache}/ssh-agent.env"
    if [ ! -e "$ssh_agent_file" ]; then
        touch "$ssh_agent_file"
    fi
    
    if ! pgrep -u "$USER" ssh-agent > /dev/null; then
        ssh-agent -t 1h > "$ssh_agent_file"
    fi

    if [[ ! -f "$SSH_AUTH_SOCK" ]]; then
        source "$ssh_agent_file" > /dev/null
    fi

fi


if __exists mcfly; then
    eval "$(mcfly init zsh)"
fi

#        zellij attach -c $USER@$(hostname)
