# Helper Functions

function __exists() {
    command -v "$1" >/dev/null 2>&1
}



# Env exports
export EDITOR="nvim"

export PAGER="less"

# Detect ssh sessions

if test -n "$ZSH_VERSION"; then
    export PROFILE_SHELL='zsh'
elif test -n "$BASH_VERSION"; then
    export PROFILE_SHELL='bash'
elif test -n "$FISH_VERSION"; then
    export PROFILE_SHELL='fish'
elif test -n "$KSH_VERSION"; then
    export PROFILE_SHELL='ksh'
elif test -n "$FCEDIT"; then
    export PROFILE_SHELL='ksh'
elif test -n "$PS3"; then
    export PROFILE_SHELL='unknown'
else
    export PROFILE_SHELL='sh'
fi


export SESSION_TYPE="local/${PROFILE_SHELL}"



if [ -n "$SSH_CLIENT" ] || [ -n "$SSH_TTY" ]; then
    SESSION_TYPE='remote/ssh'
else
    case $(ps -o comm=-p "$PPID") in
        sshd|*/sshd) SESSION_TYPE='remote/ssh';;
    esac
fi


export HISTFILE="${HOME}/.${PROFILE_SHELL}_history"


